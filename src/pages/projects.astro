---
import Layout from '../layouts/Layout.astro'
import { PortfolioSlider } from '../components/ui/PortfolioSlider/PortfolioSlider'
---

<Layout
  title="Projects — Fernando Solorzano"
  description="Web apps and projects built by Fernando Solorzano with React, Next.js, Astro, Vue and Node.js."
>
  <div id="projects" class="p-div c_container">
    <section class="projects">
      <div class="c-projects-title">
        <h2 class="projects-title-page">MY PROJECTS</h2>
      </div>
      <div class="parent-container">
        <PortfolioSlider client:only />
      </div>
    </section>
  </div>
</Layout>
